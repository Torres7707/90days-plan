# Vercel AI Gateway Authentication
# Choose one of the following authentication methods:

# Option 1: OIDC Token (recommended for local development)
# This is automatically generated when you run:
# vercel env pull
VERCEL_OIDC_TOKEN=

# Option 2: API Key (for production or CI/CD)
# Create at: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=

# Optional: Override the default Vercel AI Gateway URL
# VERCEL_AI_GATEWAY_URL=https://gateway.vercel.com

# Note: AI provider API keys (OpenAI, Anthropic, etc.) should be configured 
# in the Vercel Dashboard under AI Gateway → Integrations, not in this file

# --- Direct OpenAI-compatible endpoint (alternative to Vercel AI Gateway) ---
# Optional: use a direct OpenAI-compatible provider (e.g. OpenAI, SenseNova).
# createOpenAI() from @ai-sdk/openai reads these by default.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://token.sensenova.cn/v1

# Optional: moderation pipeline cache and rate limits.
# When unset, the pipeline uses an in-memory store for the current process.
# REDIS_URL=redis://127.0.0.1:6379