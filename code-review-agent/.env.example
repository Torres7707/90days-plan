# 复制为 .env.local（不要提交！）。只在服务端使用，不要加 NEXT_PUBLIC_ 前缀。

# 方式 A（推荐）：Vercel AI Gateway —— https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# 模型字符串格式 "provider/model"
AI_MODEL=openai/gpt-5-mini

# 方式 B：直接用某个 provider 的 key（需 npm i @ai-sdk/openai，并在 route.ts 里用 openai("gpt-5-mini")）
# OPENAI_API_KEY=
